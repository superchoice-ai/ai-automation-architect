    {
      "id": "070e3044-220e-43fb-8a91-8f57ecaf07c1",
      "name": "Y/N + Mode Validation",
      "parameters": {
        "jsCode": "const j = $json || {};\nconst channelRaw = String(j.channel || j.platform || '').toLowerCase();\nconst isLinkedIn = channelRaw === 'linkedin';\nconst mode = j.mode || 'READY_MEDIA';\nconst validMode = ['READY_MEDIA','TREND_TO_CONTENT'].includes(mode);\nconst approved = j.approved === true;\nconst dry_run = j.dry_run !== false;\nconst text = String(j.linkedin_text || j.caption || j.title || j.text || '').trim();\nconst visibility = j.visibility || 'PUBLIC';\nreturn [{ json: { ...j, platform: 'linkedin', channel_matches: isLinkedIn, mode, valid_mode: validMode, approved, dry_run, post_text: text, visibility, gate_pass: isLinkedIn && validMode && approved && !dry_run && text.length > 0 } }];"
      },
      "position": [
        224,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "f021d9bf-7dd3-43da-94b4-3b14bd890fcb",
      "name": "Dry-run / Approval Gate",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "approved",
              "leftValue": "={{ $json.approved }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": true
            },
            {
              "id": "not-dry-run",
              "leftValue": "={{ $json.dry_run }}",
              "operator": {
                "operation": "false",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": false
            },
            {
              "id": "channel-linkedin",
              "leftValue": "={{ $json.channel_matches }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": true
            },
            {
              "id": "has-text",
              "leftValue": "={{ $json.post_text.length > 0 }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": true
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
