    {
      "id": "0fdf35c0-4e5d-47c9-8be5-383007e0f681",
      "name": "Y/N + Mode Validation",
      "parameters": {
        "jsCode": "const x = $json || {};\nconst channelRaw = String(x.channel || x.platform || '').toLowerCase();\nconst isLine = channelRaw === 'line_oa' || channelRaw === 'line';\nconst mode = String(x.mode || 'READY_MEDIA');\nconst validMode = ['READY_MEDIA','TREND_TO_CONTENT'].includes(mode);\nconst approved = x.approved === true;\nconst dry_run = x.dry_run !== false;\nconst text = String(x.line_text || x.caption || x.title || x.text || '').trim();\nconst reply_token = x.reply_token || '';\nconst recipient = x.to || x.user_id || '';\nlet send_type = 'broadcast';\nif (reply_token) send_type = 'reply';\nelse if (recipient) send_type = 'push';\nreturn [{ json: { ...x, platform: 'line_oa', enabled: isLine, mode, valid_mode: validMode, approved, dry_run, channel_matches: isLine, message_text: text, reply_token, recipient, send_type, gate_pass: isLine && validMode && approved && !dry_run && text.length > 0 } }];"
      },
      "position": [
        224,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "624d0869-850c-4dc9-816e-a5a8699a8858",
      "name": "Dry-run & Approval Gate",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "approved",
              "leftValue": "={{ $json.approved }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": true
            },
            {
              "id": "not-dry-run",
              "leftValue": "={{ $json.dry_run }}",
              "operator": {
                "operation": "false",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": false
            },
            {
              "id": "channel-line",
              "leftValue": "={{ $json.channel_matches }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": true
            },
            {
              "id": "has-text",
              "leftValue": "={{ $json.message_text.length > 0 }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": true
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
      "position": [
        448,
        400
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3
    },
    {
