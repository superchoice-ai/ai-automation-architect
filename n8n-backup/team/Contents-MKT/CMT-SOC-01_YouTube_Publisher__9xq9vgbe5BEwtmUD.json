    {
      "id": "6a38d085-21f8-4308-ad49-49bce407a154",
      "name": "Normalize Input",
      "parameters": {
        "jsCode": "const x = $json || {};\nconst channel = x.channel || x.platform || (x.channels && x.channels.youtube === true ? 'youtube' : '');\nconst approved = x.approved === true;\nconst dry_run = x.dry_run !== false;\nconst matches = channel === 'youtube';\nreturn [{ json: { ...x, channel, approved, dry_run, channel_matches: matches } }];"
      },
      "position": [
        224,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "8dbf4846-ffb2-44bc-8ea5-9bef4404db8a",
      "name": "Safety Gate",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "approved",
              "leftValue": "={{ $json.approved }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": true
            },
            {
              "id": "not-dry-run",
              "leftValue": "={{ $json.dry_run }}",
              "operator": {
                "operation": "false",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": false
            },
            {
              "id": "platform-is-youtube",
              "leftValue": "={{ $json.channel_matches }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": true
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
      "position": [
        448,
        192
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3
    },
