        "jsCode": "const x=$json; const topic=x.topic||x.trend_source; return [{json:{...x,content_brief:{topic,audience:x.audience||'Thai business audience',language:x.language||'th',formats:x.formats||['short_video','infographic'],brand:'SuperChoice AI',requires_fact_check:true,requires_human_approval:true},status:'GENERATION_PLAN_READY',next:'Connect approved AI and HeyGen credentials'}}];"
      },
