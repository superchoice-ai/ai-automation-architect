        "jsCode": "const x=$json||{}; const errors=[]; if(x.mode!=='TREND_TO_CONTENT') errors.push('mode_must_be_TREND_TO_CONTENT'); if(!x.topic&&!x.trend_source) errors.push('topic_or_trend_source_required'); return [{json:{...x,generator_validation:{valid:errors.length===0,errors},generation_status:'CREDENTIAL_PENDING',external_calls_allowed:false}}];"
      },
