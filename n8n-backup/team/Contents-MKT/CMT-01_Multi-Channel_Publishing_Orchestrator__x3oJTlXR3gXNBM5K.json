    {
      "id": "0c5c4ad6-6e0f-45e5-8a41-36cbe3d15dc7",
      "name": "Normalize Publishing Request",
      "parameters": {
        "jsCode": "const j = $json || {};\nconst toBool = (v) => v === true || v === 'true' || v === 1 || v === '1';\nconst ch = (j.channels && typeof j.channels === 'object') ? j.channels : {};\nconst channels = {\n  youtube: toBool(ch.youtube),\n  facebook_page: toBool(ch.facebook_page ?? ch.facebook),\n  facebook_group: toBool(ch.facebook_group),\n  instagram: toBool(ch.instagram),\n  threads: toBool(ch.threads),\n  x: toBool(ch.x),\n  line_oa: toBool(ch.line_oa ?? ch.line),\n  linkedin: toBool(ch.linkedin),\n  // Explicitly excluded channels — never routed.\n  tiktok: false, pinterest: false, wordpress: false, heygen: false,\n};\nconst allowed = ['youtube','facebook_page','facebook_group','instagram','threads','x','line_oa','linkedin'];\nconst selected_channels = allowed.filter((c) => channels[c] === true);\nconst approved = j.approved === true;\nconst dry_run = j.dry_run !== false;\nreturn { json: {\n  ...j,\n  content_id: j.content_id || ('run-' + Date.now()),\n  approved, dry_run,\n  caption: j.caption || j.description || j.text || '',\n  description: j.description || j.caption || '',\n  text: j.text || j.caption || '',\n  media_url: j.media_url || '',\n  media_type: j.media_type || 'video',\n  title: j.title || '',\n  group_id: j.group_id || '',\n  reply_token: j.reply_token || '',\n  recipient: j.to || j.user_id || '',\n  channels, selected_channels,\n  gate_pass: approved && !dry_run && selected_channels.length > 0,\n} };",
        "mode": "runOnceForEachItem"
      },
      "position": [
        224,
        960
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
