      "name": "Aggregate Dispatch Results",
      "parameters": {
        "jsCode": "const results = $input.all().map((i) => i.json);\nconst failed = results.filter((r) => r.status === 'error' || r.published !== true);\nconst succeeded = results.filter((r) => r.published === true && r.status === 'success');\nreturn [{ json: {\n  content_id: results[0]?.content_id || '',\n  total: results.length,\n  succeeded_count: succeeded.length,\n  failed_count: failed.length,\n  platforms: results.map((r) => r.platform),\n  results, failed,\n  status: failed.length > 0 ? 'partial_failure' : 'dispatched',\n  aggregated_at: new Date().toISOString(),\n} }];"
