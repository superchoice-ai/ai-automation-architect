      "name": "Normalize Content Contract",
      "parameters": {
        "jsCode": "const x=$json||{}; const allowed=['READY_MEDIA','TREND_TO_CONTENT']; const channels=x.channels||{}; const errors=[]; if(!x.content_id) errors.push('content_id_required'); if(!allowed.includes(x.mode)) errors.push('invalid_mode'); if(typeof x.dry_run!=='boolean') errors.push('dry_run_boolean_required'); return [{json:{...x,contract_version:'CMT-1.0',channels,valid:errors.length===0,errors,received_at:new Date().toISOString()}}];"
      },
      "position": [
        -480,
        112
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
