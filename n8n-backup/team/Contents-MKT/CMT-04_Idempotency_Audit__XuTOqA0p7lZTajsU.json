    {
      "id": "b22c17dd-4d68-4a89-b9f9-e6b7a727b994",
      "name": "Build Idempotency Key",
      "parameters": {
        "jsCode": "// Version note: publishable dependency for CMT-01; logic unchanged.\nconst x=$json||{}; const channelKeys=Object.entries(x.channels||{}).filter(([,v])=>v===true||v==='Y').map(([k])=>k).sort(); const raw=[x.content_id,x.revision||1,x.mode,...channelKeys].join('|'); let h=2166136261; for(const c of raw){h^=c.charCodeAt(0);h=Math.imul(h,16777619)} const key='cmt_'+(h>>>0).toString(16); return [{json:{...x,idempotency_key:key,selected_channels:channelKeys,audit:{event:'READY_FOR_DISPATCH',content_id:x.content_id,key,secret_fields_removed:true,created_at:new Date().toISOString()}}}];"
      },
      "position": [
        -496,
        96
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "3ed3c9e3-b869-4dd9-aa0f-f7492f5052a3",
      "name": "Any Channel Selected?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.selected_channels.length}}",
              "operator": {
                "operation": "gt",
                "type": "number"
              },
              "rightValue": 0
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      },
