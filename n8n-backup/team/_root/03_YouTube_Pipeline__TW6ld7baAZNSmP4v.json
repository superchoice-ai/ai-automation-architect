    {
      "id": "e588b870-1c56-4316-b8e1-1ad3d8a204a9",
      "name": "Build Upsert Row",
      "parameters": {
        "jsCode": "// Assemble each row with REAL top-level columns AND a metadata jsonb mirror.\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const emb = items[i].json || {};\n  let src = {};\n  try {\n    const m = $('Filter New Chunks').itemMatching(i);\n    if (m && m.json) src = m.json;\n  } catch (e) { /* pairing unavailable */ }\n\n  const values = (emb.embedding && Array.isArray(emb.embedding.values)) ? emb.embedding.values\n    : (Array.isArray(emb.values) ? emb.values : []);\n  const embeddingStr = '[' + values.join(',') + ']';\n\n  const meta = {\n    document_id: src.document_id,\n    title: src.title,\n    source_type: src.source_type,\n    source_url: src.source_url,\n    chunk_index: src.chunk_index,\n    chunk_count: src.chunk_count,\n    created_at: src.created_at,\n    pipeline_version: src.pipeline_version,\n    video_id: src.video_id,\n    start_time: src.start_time,\n    timestamp_url: src.timestamp_url,\n    content_hash: src.content_hash,\n  };\n\n  out.push({ json: {\n    chunk_uid: src.chunk_uid,\n    document_id: src.document_id,\n    title: src.title,\n    source_type: src.source_type,\n    source_url: src.source_url,\n    chunk_index: src.chunk_index,\n    chunk_count: src.chunk_count,\n    content: src.text,\n    content_hash: src.content_hash,\n    created_at: src.created_at,\n    pipeline_version: src.pipeline_version,\n    video_id: src.video_id,\n    start_time: src.start_time,\n    timestamp_url: src.timestamp_url,\n    embedding: embeddingStr,\n    metadata: meta,\n  } });\n}\nreturn out;"
