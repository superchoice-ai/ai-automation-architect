      "id": "b62e788d-96b7-4e67-ad71-3c27e7bf4337",
      "name": "Filter New Chunks",
      "parameters": {
        "jsCode": "// Only embed chunks that changed / are new -> saves Gemini + re-index cost.\nconst existing = new Set();\nfor (const it of $('Check Existing Hashes').all()) {\n  const j = it.json || {};\n  if (j && j.chunk_uid) existing.add(j.chunk_uid);\n}\nconst out = [];\nfor (const it of $('Hash UID').all()) {\n  const j = it.json || {};\n  if (!j.chunk_uid) continue;\n  if (existing.has(j.chunk_uid)) continue;\n  out.push({ json: j });\n}\nreturn out;"
