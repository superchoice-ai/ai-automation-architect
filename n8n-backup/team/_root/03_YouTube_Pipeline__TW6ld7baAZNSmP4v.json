      "name": "Build Success Status",
      "parameters": {
        "jsCode": "// One status row per successfully-transcribed video.\nconst seen = {};\nconst out = [];\nconst now = new Date().toISOString();\nfor (const it of $('Parse Transcript').all()) {\n  const j = it.json || {};\n  if (j._row_status !== 'ok') continue;\n  const u = j.source_url || j.video_url;\n  if (!u || seen[u]) continue;\n  seen[u] = true;\n  out.push({ json: { ID: j.video_id, Source: u, title: j.title, status: 'processed', processed_at: now, chunk_count: j.chunk_count, error_message: '' } });\n}\nreturn out;"
