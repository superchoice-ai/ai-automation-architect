    {
      "id": "a0c277d5-908e-4118-9c71-7df6c23efd30",
      "name": "Parse Transcript",
      "parameters": {
        "jsCode": "// Convert Supadata transcript segments into Common-Schema chunks.\nconst CHUNK_SIZE = 1000;\nconst CREATED_AT = new Date().toISOString();\nconst PIPELINE_VERSION = '1.0';\n\nfunction extractVideoId(url) {\n  if (!url) return '';\n  let m = url.match(/[?&]v=([\\w-]{6,})/);\n  if (m) return m[1];\n  m = url.match(/youtu\\.be\\/([\\w-]{6,})/);\n  if (m) return m[1];\n  m = url.match(/\\/embed\\/([\\w-]{6,})/);\n  if (m) return m[1];\n  m = url.match(/\\/shorts\\/([\\w-]{6,})/);\n  if (m) return m[1];\n  return '';\n}\n\nconst items = $input.all();\nconst out = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const g = items[i].json || {};\n\n  let src = {};\n  try {\n    const m = $('Read Sheet Rows').itemMatching(i);\n    if (m && m.json) src = m.json;\n  } catch (e) { /* pairing unavailable */ }\n\n  const videoId = src.ID || extractVideoId(src.Source || src.video_url || src.url || src.link || '');\n  const url = videoId ? ('https://www.youtube.com/watch?v=' + videoId)\n    : (src.Source || src.video_url || src.url || src.link || '');\n  const title = src.Title || src.title || videoId || 'YouTube video';\n\n  let nodeError = '';\n  if (g.error) nodeError = (typeof g.error === 'string') ? g.error : (g.error.message || g.error.description || JSON.stringify(g.error));\n  if (!nodeError && g.message && !Array.isArray(g.content)) nodeError = 'Supadata: ' + String(g.message);\n\n  const content = Array.isArray(g.content) ? g.content : [];\n\n  const chunks = [];\n  let buf = '';\n  let bufStart = null;\n  for (const s of content) {\n    const t = String((s && s.text) || '').replace(/\\s+/g, ' ').trim();\n    if (!t) continue;\n    let st = 0;\n    if (s && s.offset != null) st = Number(s.offset) / 1000;\n    else if (s && s.start != null) st = Number(s.start);\n    if (!isFinite(st)) st = 0;\n    if (bufStart === null) bufStart = st;\n    if (buf && (buf.length + 1 + t.length) > CHUNK_SIZE) {\n      chunks.push({ text: buf.trim(), start: bufStart });\n      buf = t;\n      bufStart = st;\n    } else {\n      buf = buf ? buf + ' ' + t : t;\n    }\n  }\n  if (buf) chunks.push({ text: buf.trim(), start: bufStart || 0 });\n\n  const totalText = chunks.reduce((a, c) => a + c.text.length, 0);\n  if (!chunks.length || totalText < 20) {\n    let reason = nodeError;\n    if (!reason) reason = 'No transcript returned by Supadata (no captions / restricted / unsupported video)';\n    out.push({ json: { _row_status: 'error', video_url: url, source_url: url, video_id: videoId, title: title, error_message: reason } });\n    continue;\n  }\n\n  for (let c = 0; c < chunks.length; c++) {\n    const startSec = Math.floor(chunks[c].start || 0);\n    const sep = url.indexOf('?') >= 0 ? '&' : '?';\n    out.push({\n      json: {\n        _row_status: 'ok',\n        document_id: videoId,\n        title: title,\n        source_type: 'youtube',\n        source_url: url,\n        chunk_index: c,\n        chunk_count: chunks.length,\n        text: chunks[c].text,\n        created_at: CREATED_AT,\n        pipeline_version: PIPELINE_VERSION,\n        video_id: videoId,\n        start_time: startSec,\n        timestamp_url: url ? (url + sep + 't=' + startSec + 's') : '',\n      },\n    });\n  }\n}\n\nreturn out;"
      },
