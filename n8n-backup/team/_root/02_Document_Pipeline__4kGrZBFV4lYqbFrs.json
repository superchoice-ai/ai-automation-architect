    {
      "id": "e3fef4cf-9862-414a-97ce-43103d9a68cd",
      "name": "Chunk",
      "parameters": {
        "jsCode": "// Split each document's plain text into overlapping chunks.\n// Read text from \"Get Plain Text\" (Save TXT emits binary, so reference the text source directly).\nconst CHUNK_SIZE = 1000;   // characters per chunk\nconst OVERLAP = 100;       // characters shared between consecutive chunks\nconst out = [];\nfor (const item of $('Get Plain Text').all()) {\n  const j = item.json || {};\n  const text = String(j.text || '');\n  if (!text) {\n    out.push({ json: { document_id: j.document_id, title: j.title, source_type: j.source_type, chunk_index: 0, chunk_count: 0, text: '' } });\n    continue;\n  }\n  const chunks = [];\n  let start = 0;\n  while (start < text.length) {\n    const end = Math.min(start + CHUNK_SIZE, text.length);\n    chunks.push(text.slice(start, end));\n    if (end >= text.length) break;\n    start = end - OVERLAP;\n    if (start < 0) start = 0;\n  }\n  for (let i = 0; i < chunks.length; i++) {\n    out.push({\n      json: {\n        document_id: j.document_id,\n        title: j.title,\n        source_type: j.source_type,\n        chunk_index: i,\n        chunk_count: chunks.length,\n        text: chunks[i],\n      },\n    });\n  }\n}\nreturn out;"
      },
