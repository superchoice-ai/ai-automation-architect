    {
      "id": "6084405a-f704-4a17-8948-536121025529",
      "name": "Build Upsert Row",
      "parameters": {
        "jsCode": "// Assemble each row with REAL top-level columns AND a metadata jsonb mirror\n// (identical shape to 03_YouTube_Pipeline so 04 retrieval treats both the same).\n// Document specifics: video_id = document_id, source_url = Google Drive file\n// link, no start_time/timestamp_url.\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const emb = items[i].json || {};\n  let src = {};\n  try {\n    const m = $('Filter New Chunks').itemMatching(i);\n    if (m && m.json) src = m.json;\n  } catch (e) { /* pairing unavailable */ }\n\n  const values = (emb.embedding && Array.isArray(emb.embedding.values)) ? emb.embedding.values\n    : (Array.isArray(emb.values) ? emb.values : []);\n  const embeddingStr = '[' + values.join(',') + ']';   // pgvector text form\n\n  const docId = src.document_id || '';\n  const sourceUrl = docId ? ('https://drive.google.com/file/d/' + docId + '/view') : '';\n  const createdAt = src.created_at || new Date().toISOString();\n  const pipelineVersion = src.pipeline_version || '1.0';\n\n  const meta = {\n    document_id: docId,\n    title: src.title,\n    source_type: src.source_type,\n    source_url: sourceUrl,\n    chunk_index: src.chunk_index,\n    chunk_count: src.chunk_count,\n    created_at: createdAt,\n    pipeline_version: pipelineVersion,\n    video_id: docId,\n    start_time: null,\n    timestamp_url: '',\n    content_hash: src.content_hash,\n  };\n\n  out.push({ json: {\n    chunk_uid: src.chunk_uid,\n    document_id: docId,\n    title: src.title,\n    source_type: src.source_type,\n    source_url: sourceUrl,\n    chunk_index: src.chunk_index,\n    chunk_count: src.chunk_count,\n    content: src.text,\n    content_hash: src.content_hash,\n    created_at: createdAt,\n    pipeline_version: pipelineVersion,\n    video_id: docId,\n    start_time: null,\n    timestamp_url: '',\n    embedding: embeddingStr,\n    metadata: meta,\n  } });\n}\nreturn out;"
      },
