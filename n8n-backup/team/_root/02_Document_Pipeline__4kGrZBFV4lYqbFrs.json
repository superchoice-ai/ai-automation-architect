    {
      "id": "bb58d261-7068-436b-9dee-0a1cc859a064",
      "name": "Get Plain Text",
      "parameters": {
        "jsCode": "// Normalize every Extract branch into one plain-text document per source file.\n// Metadata (id / title / source_type) is pulled from the \"Download File\" node via\n// paired-item matching, so it is present for EVERY branch even when the Extract\n// node stripped the original fields (text / xml / json / spreadsheet operations).\n\nconst MIME_MAP = {\n  'application/pdf': 'pdf',\n  'text/plain': 'txt',\n  'text/csv': 'csv',\n  'text/html': 'html',\n  'application/rtf': 'rtf',\n  'text/rtf': 'rtf',\n  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': 'xlsx',\n  'application/vnd.ms-excel': 'xls',\n  'application/xml': 'xml',\n  'text/xml': 'xml',\n  'application/json': 'json',\n  'application/vnd.google-apps.document': 'gdoc',\n  'application/vnd.google-apps.spreadsheet': 'gsheet',\n  'application/vnd.google-apps.presentation': 'gslides',\n};\n\n// Pipeline/metadata keys that are NOT document content.\nconst META = ['id', 'name', 'mimeType', 'created_at', 'pipeline_version', 'document_id', 'title', 'source_type', 'status', 'char_count', 'numpages'];\nconst NL = String.fromCharCode(10);\n\nfunction sourceType(mime, name) {\n  if (MIME_MAP[mime]) return MIME_MAP[mime];\n  if (name && name.includes('.')) return name.split('.').pop().toLowerCase();\n  return 'unknown';\n}\n\n// Turn one extracted item into a text fragment.\nfunction renderText(j) {\n  if (typeof j.text === 'string') return j.text;                 // PDF / TXT / RTF / GDoc / OCR\n  if (j.text !== undefined && j.text !== null) {                 // XML / JSON (object under \"text\")\n    return JSON.stringify(j.text, null, 2);\n  }\n  // Spreadsheet / tabular row -> readable \"Column: value\" lines so each chunk\n  // stays self-describing even if a chunk boundary splits the document.\n  const lines = [];\n  for (const k of Object.keys(j)) {\n    if (META.includes(k)) continue;\n    let v = j[k];\n    if (v === null || v === undefined) v = '';\n    else if (typeof v === 'object') v = JSON.stringify(v);\n    lines.push(k + ': ' + v);\n  }\n  return lines.join(NL);\n}\n\nconst items = $input.all();\nconst downloads = $('Download File').all();\n\n// Group incoming items back to their source file (spreadsheets fan out into many\n// rows -> many items that all trace back to the same Download File item).\nconst groups = new Map();\nfor (let i = 0; i < items.length; i++) {\n  const j = items[i].json || {};\n  let src = {};\n  try {\n    const m = $('Download File').itemMatching(i);\n    if (m && m.json) src = m.json;\n  } catch (e) { /* pairing unavailable */ }\n  if (!src.id && downloads.length === 1) src = downloads[0].json || {};\n  const key = src.id || j.id || j.document_id || ('doc_' + i);\n  if (!groups.has(key)) groups.set(key, { src: src, rows: [] });\n  groups.get(key).rows.push(j);\n}\n\nconst out = [];\nfor (const entry of groups) {\n  const g = entry[1];\n  const src = g.src || {};\n  const name = src.name || '';\n  const mime = src.mimeType || '';\n  const parts = [];\n  for (const r of g.rows) {\n    const frag = renderText(r);\n    if (frag && frag.length) parts.push(frag);\n  }\n  const text = parts.join(NL + NL);\n  const meta = g.rows[0] || {};\n  out.push({\n    json: {\n      document_id: src.id || '',\n      title: name,\n      source_type: sourceType(mime, name),\n      created_at: meta.created_at || null,\n      pipeline_version: meta.pipeline_version || null,\n      text: text,\n      char_count: text.length,\n      status: 'Extracted',\n    },\n  });\n}\nreturn out;"
      },
      "position": [
        672,
        1056
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
