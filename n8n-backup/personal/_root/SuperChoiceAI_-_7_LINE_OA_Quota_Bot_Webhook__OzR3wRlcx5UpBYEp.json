                      "type": "string"
                    },
                    "rightValue": "register"
                  }
                ],
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 1
                }
              },
              "outputKey": "register",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "or",
                "conditions": [
                  {
                    "leftValue": "={{ $json.text }}",
                    "operator": {
