    {
      "id": "96e552cc-9dd0-462f-a8dc-37090ca95cf2",
      "name": "Build Register Reply",
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst url = 'https://superchoiceai.app.n8n.cloud/form/superchoiceai-register?line_user_id=' + encodeURIComponent(j.line_user_id) + '&oa_id=' + encodeURIComponent(j.oa_id);\nconst text = '📝 ลงทะเบียน / ผูก API Key\\nกดลิงก์ด้านล่างเพื่อผูกคีย์ AI ของคุณอย่างปลอดภัย:\\n' + url;\nreturn [{ json: { replyToken: j.replyToken, line_user_id: j.line_user_id, oa_id: j.oa_id, text } }];"
      },
      "position": [
        1120,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "3f47efcd-239c-47fe-9017-52a4c4dcc4f4",
      "name": "Format Or Text",
      "parameters": {
        "jsonOutput": "={{ JSON.stringify({ replyToken: $json.replyToken, line_user_id: $json.line_user_id, oa_id: $json.oa_id, text: $json.text }) }}",
        "mode": "raw",
        "options": {}
      },
      "position": [
        1344,
        192
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4
    },
