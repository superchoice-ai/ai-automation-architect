    {
      "id": "e63718b8-3cb1-43bf-b48d-2556a64d37f3",
      "name": "Parse Events",
      "parameters": {
        "jsCode": "const body = ($input.first().json.body) || {};\nconst destination = body.destination || '';\nconst events = Array.isArray(body.events) ? body.events : [];\nconst out = [];\nfor (const e of events) {\n  if (e && e.type === 'message' && e.message && e.message.type === 'text' && e.source && e.source.userId) {\n    out.push({ json: {\n      replyToken: e.replyToken,\n      line_user_id: e.source.userId,\n      oa_id: destination,\n      text: String(e.message.text || '').trim()\n    }});\n  }\n}\nreturn out;"
      },
      "position": [
        448,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "eed5f743-b4fa-416c-b2d1-726e9f0a5c71",
      "name": "Route Intent",
      "parameters": {
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "help"
        },
        "rules": {
          "values": [
