                      "type": "string"
                    },
                    "rightValue": "สมัคร"
                  }
                ],
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 1
                }
              },
              "outputKey": "register_th",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "or",
                "conditions": [
                  {
