      "id": "309d9dea-2df6-4c05-9c0f-fd4af72bc4a3",
      "name": "Reconciliation Sweep",
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "SELECT qu.provider_account_id, qu.service_type, qu.model, qu.used_value, qu.limit_value,\n       qu.reset_at, qu.cycle_key, la.line_user_id, la.oa_id,\n       round(qu.used_value::numeric / NULLIF(qu.limit_value, 0) * 100) AS percent\nFROM quota_usage qu\nJOIN provider_accounts pa ON pa.id = qu.provider_account_id\nJOIN app_users u ON u.id = pa.app_user_id\nJOIN line_accounts la ON la.app_user_id = u.id\nWHERE pa.status = 'active';"
      },
      "position": [
        448,
        192
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "75f1581f-1e4b-49f4-a772-7363be8e2706",
      "name": "Sweep Thresholds",
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst thresholds = [70, 80, 90, 100];\nconst out = [];\nfor (const r of rows) {\n  const limit = Number(r.limit_value) || 0;\n  const used = Number(r.used_value) || 0;\n  if (limit <= 0) continue;\n  const percent = (used / limit) * 100;\n  for (const t of thresholds) {\n    if (percent >= t) {\n      out.push({ json: {\n        line_user_id: r.line_user_id,\n        oa_id: r.oa_id,\n        provider_account_id: r.provider_account_id,\n        service_type: r.service_type,\n        model: r.model,\n        threshold: String(t),\n        used_value: used,\n        limit_value: limit,\n        reset_at: r.reset_at,\n        cycle_key: r.cycle_key\n      }});\n    }\n  }\n}\nreturn out;"
      },
      "position": [
        672,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
