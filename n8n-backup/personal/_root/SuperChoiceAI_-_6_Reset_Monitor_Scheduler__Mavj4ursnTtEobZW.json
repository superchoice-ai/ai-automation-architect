    {
      "id": "ba4b1126-08cb-4260-b37a-fd7e01d08b22",
      "name": "Compute Keys",
      "parameters": {
        "jsCode": "const nowBkk = $now.setZone('Asia/Bangkok');\nconst dailyKey = nowBkk.toFormat('yyyy-MM-dd');\nconst monthlyKey = nowBkk.toFormat('yyyy-MM');\nconst nextDaily = nowBkk.plus({ days: 1 }).startOf('day').toISO();\nconst nextMonthly = nowBkk.plus({ months: 1 }).startOf('month').toISO();\nreturn [{ json: { dailyKey, monthlyKey, nextDaily, nextMonthly } }];"
      },
      "position": [
        224,
        96
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "credentials": {
        "postgres": {
          "id": "__REDACTED__",
          "name": "__REDACTED__"
        }
      },
      "disabled": true,
      "id": "c7e28762-14e9-4e81-98c1-082fe4e96e30",
      "name": "Reset Rolled-Over",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ $json.dailyKey }},={{ $json.monthlyKey }},={{ $json.nextDaily }},={{ $json.nextMonthly }}"
        },
        "query": "UPDATE quota_usage qu\nSET used_value = 0,\n    cycle_key = CASE WHEN qp.reset_policy = 'monthly' THEN $2 ELSE $1 END,\n    reset_at  = CASE WHEN qp.reset_policy = 'monthly' THEN $4::timestamptz ELSE $3::timestamptz END,\n    updated_at = now()\nFROM quota_policies qp, provider_accounts pa, app_users u, line_accounts la\nWHERE pa.id = qu.provider_account_id\n  AND qp.provider_code = pa.provider_code\n  AND qp.service_type = qu.service_type\n  AND qp.scope = qu.scope\n  AND qp.license_type = pa.license_type\n  AND u.id = pa.app_user_id\n  AND la.app_user_id = u.id\n  AND (\n    (qp.reset_policy = 'daily'   AND qu.cycle_key <> $1) OR\n    (qp.reset_policy = 'monthly' AND qu.cycle_key <> $2)\n  )\nRETURNING qu.provider_account_id, qu.service_type, qu.model, qu.cycle_key, la.line_user_id, la.oa_id;"
      },
      "position": [
        448,
        0
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
