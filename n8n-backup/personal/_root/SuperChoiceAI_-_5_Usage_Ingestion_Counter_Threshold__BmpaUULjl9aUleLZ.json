    {
      "id": "6854b8c8-088e-44af-bc5c-c685447aebd9",
      "name": "Normalize",
      "parameters": {
        "jsCode": "const b = ($input.first().json.body) || {};\nconst unit = b.unit || 'requests';\nconst delta = (unit === 'tokens') ? (Number(b.tokens) || 0) : (Number(b.delta) || 1);\n// cycle_key in Asia/Bangkok\nconst nowBkk = $now.setZone('Asia/Bangkok');\nconst cycle_key = nowBkk.toFormat('yyyy-MM-dd');\nconst reset_at = nowBkk.plus({ days: 1 }).startOf('day').toISO();\nreturn [{ json: {\n  line_user_id: b.line_user_id || '',\n  oa_id: b.oa_id || '',\n  provider_code: b.provider_code || 'gemini',\n  service_type: b.service_type || 'chat',\n  model: b.model || 'unknown',\n  license_type: b.license_type || 'free',\n  unit,\n  effective_delta: delta,\n  ratelimit_headers: b.ratelimit_headers || null,\n  cycle_key,\n  reset_at\n} }];"
      },
      "position": [
        224,
        288
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "credentials": {
        "postgres": {
          "id": "__REDACTED__",
          "name": "__REDACTED__"
        }
      },
      "id": "e7db1fdf-8009-4a09-8dd2-da0873467bd9",
      "name": "Resolve Account",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ $json.line_user_id }},={{ $json.oa_id }},={{ $json.provider_code }}"
        },
        "query": "SELECT pa.id, pa.license_type\nFROM provider_accounts pa\nJOIN app_users u ON u.id = pa.app_user_id\nJOIN line_accounts la ON la.app_user_id = u.id\nWHERE la.line_user_id = $1 AND la.oa_id = $2 AND pa.provider_code = $3 AND pa.status = 'active'\nLIMIT 1;"
      },
      "position": [
        448,
        288
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "ab3a2e14-d901-4817-8caf-e5d38ed8aba1",
