    {
      "id": "e52451c3-0533-421a-960f-fc5e34c374e2",
      "name": "Build Summary",
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst usage = rows.map(r => ({\n  service_type: r.service_type,\n  model: r.model,\n  scope: r.scope,\n  used: Number(r.used_value) || 0,\n  limit: Number(r.limit_value) || 0,\n  percent: (Number(r.limit_value) > 0) ? Math.round((Number(r.used_value) / Number(r.limit_value)) * 100) : 0\n}));\nreturn [{ json: { ok: true, usage } }];"
      },
      "position": [
        1120,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "38aa6641-4c29-4d87-83f0-a91ebcb6c422",
      "name": "Respond OK",
      "parameters": {
