    {
      "id": "d3841257-4f03-438a-95ac-47f4510da399",
      "name": "Threshold Check",
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst norm = $('Normalize').first().json;\nconst thresholds = [70, 80, 90, 100];\nconst out = [];\nfor (const r of rows) {\n  const used = Number(r.used_value) || 0;\n  const limit = Number(r.limit_value) || 0;\n  if (limit <= 0) continue;\n  const percent = (used / limit) * 100;\n  for (const t of thresholds) {\n    if (percent >= t) {\n      out.push({ json: {\n        line_user_id: norm.line_user_id,\n        oa_id: norm.oa_id,\n        provider_account_id: r.provider_account_id,\n        service_type: r.service_type,\n        model: r.model,\n        threshold: String(t),\n        used_value: used,\n        limit_value: limit,\n        reset_at: r.reset_at,\n        cycle_key: r.cycle_key\n      }});\n    }\n  }\n}\nreturn out;"
      },
      "position": [
        1120,
        384
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
