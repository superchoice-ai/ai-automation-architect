      "id": "8dee0316-ed4b-45d8-8c4c-5f6e12d2a0d6",
      "name": "Upsert Counters",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ $('Resolve Account').item.json.id }},={{ $('Normalize').item.json.service_type }},={{ $('Normalize').item.json.model }},={{ $('Normalize').item.json.license_type }},={{ $('Normalize').item.json.provider_code }},={{ $('Normalize').item.json.unit }},={{ $('Normalize').item.json.effective_delta }},={{ $('Normalize').item.json.cycle_key }},={{ $('Normalize').item.json.reset_at }}"
        },
        "query": "WITH params AS (\n  SELECT $1::uuid AS acc,\n         $2::text AS service_type,\n         $3::text AS model,\n         $4::text AS license,\n         $5::text AS provider,\n         $6::text AS unit,\n         $7::bigint AS delta,\n         $8::text AS cycle_key,\n         $9::timestamptz AS reset_at\n), rows AS (\n  SELECT p.acc, p.service_type, '*'::text AS model, 'service'::text AS scope, p.unit, p.delta, p.cycle_key, p.reset_at,\n    (SELECT limit_value FROM quota_policies qp WHERE qp.provider_code=p.provider AND qp.service_type=p.service_type AND qp.license_type=p.license AND qp.scope='service' AND qp.model='*' LIMIT 1) AS limit_value\n  FROM params p\n  UNION ALL\n  SELECT p.acc, p.service_type, p.model, 'model'::text AS scope, p.unit, p.delta, p.cycle_key, p.reset_at,\n    (SELECT limit_value FROM quota_policies qp WHERE qp.provider_code=p.provider AND qp.service_type=p.service_type AND qp.license_type=p.license AND qp.scope='model' AND qp.model=p.model LIMIT 1) AS limit_value\n  FROM params p\n)\nINSERT INTO quota_usage(provider_account_id, service_type, model, scope, unit, used_value, limit_value, cycle_key, reset_at)\nSELECT acc, service_type, model, scope, unit, delta, limit_value, cycle_key, reset_at FROM rows\nON CONFLICT (provider_account_id, service_type, model, scope)\nDO UPDATE SET used_value = quota_usage.used_value + EXCLUDED.used_value, updated_at = now()\nRETURNING provider_account_id, service_type, model, scope, used_value, limit_value, reset_at, cycle_key;"
      },
      "position": [
        896,
        192
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "credentials": {
