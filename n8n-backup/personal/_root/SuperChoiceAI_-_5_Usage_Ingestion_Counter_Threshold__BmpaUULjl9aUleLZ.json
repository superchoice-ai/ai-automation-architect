      "id": "5ea4e112-79ca-47fc-911c-9b3cbbae9551",
      "name": "Append History",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ $('Resolve Account').item.json.id }},={{ $('Normalize').item.json.service_type }},={{ $('Normalize').item.json.model }},={{ $('Normalize').item.json.effective_delta }},={{ $('Normalize').item.json.unit }}"
        },
        "query": "INSERT INTO usage_history(provider_account_id, service_type, model, delta, unit, source)\nVALUES ($1::uuid, $2, $3, $4::bigint, $5, 'webhook');"
      },
      "position": [
        1120,
