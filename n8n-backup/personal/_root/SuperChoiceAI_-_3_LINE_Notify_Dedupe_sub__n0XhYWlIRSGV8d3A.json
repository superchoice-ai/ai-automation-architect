    {
      "id": "86b0ac7a-29c9-4d86-8da7-29142a3ea6e3",
      "name": "Build Message",
      "parameters": {
        "jsCode": "const t = $('When Called').item.json;\nconst token = $input.first().json.token;\nconst used = Number(t.used_value) || 0;\nconst limit = Number(t.limit_value) || 0;\nconst percent = limit > 0 ? Math.round((used / limit) * 100) : 0;\nconst provider = 'Gemini';\nconst svc = t.service_type || '';\nconst model = t.model && t.model !== '*' ? t.model : (t.service_type || '');\nconst resetAt = t.reset_at || '';\nlet text = t.message_text || '';\nif (!text) {\n  const thr = String(t.threshold);\n  if (thr === 'RESET') {\n    text = '🔄 ' + provider + ' โควต้ารอบใหม่เริ่มแล้ว\\n' + svc + (model ? (' / ' + model) : '') + '\\nใช้งานได้เต็มจำนวนอีกครั้ง';\n  } else if (thr === '100') {\n    text = '🛑 ' + provider + ' โควต้าหมดแล้ว (100%)\\n' + svc + (model ? (' / ' + model) : '') + '\\nใช้ไป ' + used + '/' + limit + '\\nรีเซ็ต: ' + resetAt;\n  } else {\n    text = '⚠️ ' + provider + ' โควต้าใกล้เต็ม (' + thr + '%)\\n' + svc + (model ? (' / ' + model) : '') + '\\nใช้ไป ' + used + '/' + limit + ' (' + percent + '%)\\nรีเซ็ต: ' + resetAt;\n  }\n}\nreturn [{ json: {\n  line_user_id: t.line_user_id,\n  token,\n  text\n} }];"
      },
      "position": [
        1344,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
