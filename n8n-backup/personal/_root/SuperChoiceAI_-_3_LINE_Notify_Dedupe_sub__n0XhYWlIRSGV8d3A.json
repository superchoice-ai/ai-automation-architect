      "id": "ab33efb8-a63e-4836-85d9-8741b3beba09",
      "name": "Dedupe Insert Log",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ $json.provider_account_id }},={{ $json.service_type }},={{ $json.model }},={{ $json.threshold }},={{ $json.cycle_key }}"
        },
        "query": "INSERT INTO notification_log(provider_account_id, service_type, model, threshold, cycle_key)\nVALUES ($1, $2, $3, $4, $5)\nON CONFLICT (provider_account_id, service_type, model, threshold, cycle_key) DO NOTHING\nRETURNING id;"
