      "id": "ae266eaf-5bde-4a20-999f-5b91c339efbe",
      "name": "Lookup OA Token",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ $('When Called').item.json.oa_id }}"
        },
        "query": "SELECT v.decrypted_secret AS token\nFROM line_oa_configs c\nJOIN vault.decrypted_secrets v ON v.id = c.channel_access_token_secret\nWHERE c.oa_id = $1\nLIMIT 1;"
