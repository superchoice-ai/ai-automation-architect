    {
      "id": "4331873a-f3d4-4a33-880d-04e356d2ed4d",
      "name": "Normalize Validate",
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\nconst status = item.statusCode;\nconst body = item.body || item || {};\nif (typeof status === 'number' && status >= 200 && status < 300) {\n  const models = Array.isArray(body.models) ? body.models.map(m => m.name || m.displayName).filter(Boolean) : [];\n  return [{ json: { provider: 'gemini', valid: true, models } }];\n}\nconst err = (body && body.error && body.error.message) ? body.error.message : ('HTTP ' + (status ?? 'error'));\nreturn [{ json: { provider: 'gemini', valid: false, error: err } }];"
      },
      "position": [
        896,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
