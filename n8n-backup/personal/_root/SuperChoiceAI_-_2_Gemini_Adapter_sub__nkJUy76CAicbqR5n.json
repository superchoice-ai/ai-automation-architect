      "name": "Probe Usage",
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst headers = input.ratelimit_headers || input.headers || null;\nreturn [{ json: {\n  provider: 'gemini',\n  supported: false,\n  note: 'Gemini has no quota-remaining endpoint; usage is self-counted',\n  headers: headers || null\n} }];"
